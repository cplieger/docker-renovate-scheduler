// Example Renovate self-hosted bot configuration.
//
// This file holds Renovate's own settings. The scheduler's settings are
// RUN_INTERVAL, RUN_TIMEOUT and LOG_LEVEL, set in the environment. The
// scheduler checks before each run that RENOVATE_BASE_DIR is writable. That
// check does not see a `baseDir` set in this file. The scheduler also reads
// HOME and RENOVATE_CUSTOM_ENV_VARIABLES to warn when a non-default user cannot
// write the tool caches.
//
// Mount this file at /usr/src/app/config.js, or point RENOVATE_CONFIG_FILE at
// it, if you prefer a file to RENOVATE_* environment variables. Every option is
// documented at https://docs.renovatebot.com/self-hosted-configuration/
//
// Keep secrets such as tokens in the environment and out of this file.

module.exports = {
  platform: 'github',
  token: process.env.RENOVATE_TOKEN,
  // Silences the warning Renovate logs when no github.com token is set. It
  // supplies no token. Set RENOVATE_GITHUB_COM_TOKEN in the environment for
  // changelog lookups and to avoid github.com API rate limits.
  githubTokenWarn: false,

  // Which repositories to process. Keep one of these three lines:
  autodiscover: true,
  // autodiscoverFilter: ['cplieger/*'],
  // repositories: ['owner/repo', 'cplieger/docker-renovate-scheduler'],

  // Onboarding behaviour for a self-hosted org bot.
  onboardingConfig: {
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: ['config:recommended'],
  },

  // Resident-container performance: keep repo data and the extraction cache
  // between runs so each run does a git fetch rather than a fresh clone. The
  // scheduler image sets RENOVATE_BASE_DIR=/data; persist that volume.
  persistRepoData: true,
  repositoryCache: 'enabled',
};
