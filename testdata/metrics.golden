# HELP renovate_scheduler_last_run_exit_code Renovate's exit code in the scope's last completed run; -1 when Renovate did not run or a signal ended it.
# TYPE renovate_scheduler_last_run_exit_code gauge
renovate_scheduler_last_run_exit_code{scope="full"} -1
renovate_scheduler_last_run_exit_code{scope="scoped"} 1
# HELP renovate_scheduler_last_run_timestamp_seconds Unix time the scope's last completed run ended.
# TYPE renovate_scheduler_last_run_timestamp_seconds gauge
renovate_scheduler_last_run_timestamp_seconds{scope="full"} 1772366400
renovate_scheduler_last_run_timestamp_seconds{scope="scoped"} 1772373600
# HELP renovate_scheduler_last_success_timestamp_seconds Unix time the scope's last complete run ended; for the full scope, read back from RENOVATE_BASE_DIR after a restart.
# TYPE renovate_scheduler_last_success_timestamp_seconds gauge
renovate_scheduler_last_success_timestamp_seconds{scope="full"} 1772344800
renovate_scheduler_last_success_timestamp_seconds{scope="scoped"} 1772370000
# HELP renovate_scheduler_last_run_duration_seconds How long the scope's last completed run took.
# TYPE renovate_scheduler_last_run_duration_seconds gauge
renovate_scheduler_last_run_duration_seconds{scope="full"} 270.5
renovate_scheduler_last_run_duration_seconds{scope="scoped"} 42.25
# HELP renovate_scheduler_failing_since_timestamp_seconds Unix time the scope's current series of tolerable failures began; 0 when runs are not failing.
# TYPE renovate_scheduler_failing_since_timestamp_seconds gauge
renovate_scheduler_failing_since_timestamp_seconds{scope="full"} 0
renovate_scheduler_failing_since_timestamp_seconds{scope="scoped"} 1772361000
# HELP renovate_scheduler_info Always 1; the labels name the scheduling mode and the GitHub auth mode.
# TYPE renovate_scheduler_info gauge
renovate_scheduler_info{auth="app",mode="built-in"} 1
# HELP renovate_scheduler_run_deadline_timestamp_seconds Unix time by which the next complete full run is due; 0 while RUN_INTERVAL is off.
# TYPE renovate_scheduler_run_deadline_timestamp_seconds gauge
renovate_scheduler_run_deadline_timestamp_seconds 1772391600
# HELP renovate_scheduler_next_run_timestamp_seconds Unix time the built-in schedule next starts a full run; 0 while RUN_INTERVAL is off.
# TYPE renovate_scheduler_next_run_timestamp_seconds gauge
renovate_scheduler_next_run_timestamp_seconds 0
